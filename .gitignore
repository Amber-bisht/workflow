# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies — root and all nested packages (monorepo)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js — root and nested (e.g. apps/web/.next)
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
/notes/git_credentials.md

# Cloudinary — local crop cache (stored in Cloudinary now)
public/runs/

# Local-only folders
notes/
scratch/
.git1
dist
